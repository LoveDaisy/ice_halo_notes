!/[0-9][0-9]*-*/data/**/*.log
!/[0-9][0-9]*-*/data/**/*.tsv
!/[0-9][0-9]*-*/img/**/.gitkeep
!/[0-9][0-9]*-*/data/**/.gitkeep
/[0-9][0-9]*-*/data/analysis/
/[0-9][0-9]*-*/data/analysis_*/
