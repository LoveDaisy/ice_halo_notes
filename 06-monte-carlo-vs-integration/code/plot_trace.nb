Cell[BoxData[
 RowBox[{
  RowBox[{"LineIntersect", "[", 
   RowBox[{"p1_", ",", "p2_", ",", "q1_", ",", "r_"}], "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", "sol", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"sol", "=", 
      RowBox[{"LinearSolve", "[", 
       RowBox[{
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"p2", "-", "p1"}], ",", 
           RowBox[{"-", "r"}]}], "}"}], "]"}], ",", 
        RowBox[{"q1", "-", "p1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"p2", "-", "p1"}], ")"}], 
       RowBox[{"sol", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], "+", "p1"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
