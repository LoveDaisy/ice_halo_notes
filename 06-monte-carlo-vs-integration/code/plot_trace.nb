    RowBox[{
     RowBox[{"{", 
      RowBox[{"norm", ",", "nr", ",", "a", ",", "c", ",", "d"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"norm", "=", 
       RowBox[{"Normalize", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", 
             RowBox[{"-", "1"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "0"}], "}"}]}], "}"}], ".", 
         RowBox[{"(", 
          RowBox[{"p2", "-", "p1"}], ")"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"nr", "=", 
       RowBox[{"Normalize", "[", "r", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"c", "=", 
       RowBox[{"nr", ".", "norm"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"d", "=", 
       RowBox[{
        RowBox[{"c", "^", "2"}], "-", "1", "+", 
        RowBox[{"nRelative", "^", "2"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"a", "=", 
       RowBox[{"c", "-", 
        RowBox[{
         RowBox[{"Sign", "[", "c", "]"}], 
         RowBox[{"Sqrt", "[", "d", "]"}]}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Normalize", "[", 
       RowBox[{"nr", "-", 
        RowBox[{"a", " ", "norm"}]}], "]"}]}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
